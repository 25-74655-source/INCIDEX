<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:orientation="vertical">

    <!-- HEADER + PROGRESS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="36dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/user_bg_edit_badge"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="#111827"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Report an Incident"
                    android:textColor="#111827"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStepSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/seg1"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/seg2"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/seg3"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/seg4"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/seg5"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- STEPS -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/stepLocation"
            layout="@layout/report_step_location"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/stepType"
            layout="@layout/report_step_type"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/stepSeverity"
            layout="@layout/report_step_severity"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/stepDetails"
            layout="@layout/report_step_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/stepReview"
            layout="@layout/report_step_review"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- NEXT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_login_button"
            android:letterSpacing="0"
            android:stateListAnimator="@null"
            android:text="Next  ›"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:backgroundTint="@null" />
    </LinearLayout>
</LinearLayout>