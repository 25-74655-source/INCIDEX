<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:orientation="vertical">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="36dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incident Management"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SEARCH -->
    <EditText
        android:id="@+id/edtAdminSearch"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/user_bg_card"
        android:drawableStart="@drawable/admin_ic_search"
        android:drawablePadding="10dp"
        android:drawableTint="#94A3B8"
        android:hint="Search category, location, reporter…"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#111827"
        android:textColorHint="#94A3B8"
        android:textSize="13sp" />

    <!-- FILTER CHIPS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/adminChipAll"
                style="@style/UserChip"
                android:layout_marginEnd="8dp"
                android:text="All" />

            <TextView
                android:id="@+id/adminChipSubmitted"
                style="@style/UserChip"
                android:layout_marginEnd="8dp"
                android:text="Submitted" />

            <TextView
                android:id="@+id/adminChipVerified"
                style="@style/UserChip"
                android:layout_marginEnd="8dp"
                android:text="Verified" />

            <TextView
                android:id="@+id/adminChipResolved"
                style="@style/UserChip"
                android:layout_marginEnd="8dp"
                android:text="Resolved" />

            <TextView
                android:id="@+id/adminChipRejected"
                style="@style/UserChip"
                android:text="Rejected" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- LIST -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAdminIncidents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/txtAdminEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/user_bg_card"
            android:gravity="center"
            android:padding="24dp"
            android:text="No incidents found"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- BOTTOM NAV -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/adminBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:itemIconTint="@color/user_nav_item_color"
        app:itemTextColor="@color/user_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/admin_bottom_nav" />
</LinearLayout>